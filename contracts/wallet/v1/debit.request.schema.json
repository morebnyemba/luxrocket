{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.luxrocket.example/wallet/v1/debit.request.schema.json",
  "title": "Wallet debit request (platform -> operator)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transaction_id",
    "bet_id",
    "round_id",
    "player_id",
    "currency",
    "amount",
    "game",
    "created_at"
  ],
  "properties": {
    "transaction_id": {
      "type": "string",
      "pattern": "^tx_[0-9a-z]{26}$"
    },
    "bet_id": {
      "type": "string"
    },
    "round_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "operator_session_token": {
      "type": "string",
      "maxLength": 512
    },
    "player_id": {
      "type": "string",
      "maxLength": 128
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "amount": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,17}$",
      "description": "Positive integer amount in minor units, as a string"
    },
    "game": {
      "const": "lux-rocket"
    },
    "panel": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

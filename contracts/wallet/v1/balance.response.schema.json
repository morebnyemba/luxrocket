{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.luxrocket.example/wallet/v1/balance.response.schema.json",
  "title": "Wallet balance response (operator -> platform)",
  "type": "object",
  "required": [
    "status",
    "balance",
    "currency"
  ],
  "properties": {
    "status": {
      "const": "OK"
    },
    "balance": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})$",
      "description": "Integer amount in currency minor units, as a string"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    }
  }
}

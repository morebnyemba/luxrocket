{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.luxrocket.example/ws/v1/server-event.schema.json",
  "title": "Server event envelope (lr.v1)",
  "type": "object",
  "required": [
    "type",
    "v",
    "server_ts"
  ],
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^[A-Z_]+$"
    },
    "v": {
      "const": 1
    },
    "stream_id": {
      "type": "string"
    },
    "round_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Per-stream sequence for public events"
    },
    "pseq": {
      "type": "integer",
      "minimum": 0,
      "description": "Per-session sequence for private events"
    },
    "server_ts": {
      "type": "integer",
      "description": "Unix epoch milliseconds"
    },
    "data": {
      "type": "object"
    }
  }
}

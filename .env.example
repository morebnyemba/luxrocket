# Copy to .env for local development. Never commit real secrets.
POSTGRES_DB=luxrocket
POSTGRES_USER=luxrocket
POSTGRES_PASSWORD=luxrocket-dev-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://luxrocket:luxrocket-dev-only@localhost:5672/luxrocket
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
